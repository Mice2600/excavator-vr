---
import { Picture } from 'astro:assets';
import { t, type Lang } from '../i18n';
import { img } from '../images';
import SectionHead from './SectionHead.astro';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const g = d.together;
---

<section class="sec together" id="together">
  <div class="together__grid">
    <div class="together__text">
      <SectionHead n="08" kicker={g.kicker} title={g.title} lead={g.lead} />
      <ul class="ticks" data-reveal>
        {g.items.map((it) => <li>{it}</li>)}
      </ul>
      <p class="status" data-reveal>
        <span class="status__tag">{g.status}</span>
        {g.note}
      </p>
    </div>
    <div class="together__pic" data-reveal aria-hidden="true">
      <div class="together__a">
        <Picture
          src={img('ex20_34')}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(max-width: 1000px) 60vw, 30vw"
          alt=""
          loading="lazy"
          quality={60}
        />
      </div>
      <div class="together__b">
        <Picture
          src={img('ex20_red')}
          formats={['avif', 'webp']}
          widths={[480, 800, 1200]}
          sizes="(max-width: 1000px) 60vw, 30vw"
          alt=""
          loading="lazy"
          quality={60}
        />
      </div>
    </div>
  </div>
</section>
