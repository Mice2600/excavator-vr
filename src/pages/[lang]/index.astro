---
import Cab from '../../components/Cab.astro';
import Closing from '../../components/Closing.astro';
import Controls from '../../components/Controls.astro';
import Downloads from '../../components/Downloads.astro';
import Feel from '../../components/Feel.astro';
import Film from '../../components/Film.astro';
import Fleet from '../../components/Fleet.astro';
import Ground from '../../components/Ground.astro';
import Hero from '../../components/Hero.astro';
import Nav from '../../components/Nav.astro';
import Proof from '../../components/Proof.astro';
import Together from '../../components/Together.astro';
import Views from '../../components/Views.astro';
import Vr from '../../components/Vr.astro';
import { languages, type Lang } from '../../i18n';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return languages.map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Lang;
---

<Base lang={lang}>
  <div class="grain" aria-hidden="true"></div>
  <Nav lang={lang} />
  <main id="main">
    <Hero lang={lang} />
    <Vr lang={lang} n="01" />
    <Feel lang={lang} />
    <Fleet lang={lang} />
    <Ground lang={lang} />
    <Controls lang={lang} />
    <Cab lang={lang} n="06" />
    <Views lang={lang} />
    <Film lang={lang} />
    <Together lang={lang} />
    <Proof lang={lang} />
    <Downloads lang={lang} />
  </main>
  <Closing lang={lang} />
  <script>
    import '../../scripts/main.ts';
  </script>
</Base>
